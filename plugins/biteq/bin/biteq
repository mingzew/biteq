#!/usr/bin/env python3
"""biteq: bite-size coding questions while your AI agent is thinking.

  biteq pane [--lang python,ruby]   open the quiz pane (keep it in a split next to your agent)
  biteq hook [--source claude]      called by Claude Code hooks (reads hook JSON on stdin)
  biteq langs                       list question banks; shows the remembered selection
  biteq check                       validate the question banks
  biteq stats                       show your stats
  biteq doctor                      check the setup
  biteq reset [--all]               clear live sessions (and stats/config with --all)
  biteq start | stop                manual signals, for debugging

Stdlib only; works with python3 >= 3.8 (macOS system python is 3.9). Code lives in ../lib/biteq.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

if len(sys.argv) > 1 and sys.argv[1] == "hook":
    # Hook fast path: never print, always exit 0. Anything else (including a bad flag or
    # an import error) must not reach Claude as a hook failure (exit 2 would block the agent).
    try:
        from biteq.cli import hook_main
        hook_main(sys.argv[2:])
    except BaseException:
        pass
    sys.exit(0)

from biteq.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
